# =============================================================================
# .env.template
# Copy this file to ".env" (same folder) and fill in YOUR real Azure account
# details ONLY if you want to run against real Azure Blob/ADLS Gen2 instead of
# the default offline local-filesystem mode.
#
# This file is NEVER read automatically by java - it is a reference for which
# environment variables to export in your shell, OR which values to paste
# into IntelliJ's Run Configuration "Environment Variables" field
# (Run > Edit Configurations > Environment variables > click the folder icon).
#
# IMPORTANT: Never commit a filled-in ".env" to source control. Add ".env" to
# .gitignore. Leave every value blank below and the app runs fully offline.
# =============================================================================

# --- Environment selector (Multi-Env Isolation) ---
APP_ENV=dev
POD_NAMESPACE=banking-dev

# --- Run mode toggle ---
# Set to "true" to route all reads/writes through real Azure ADLS Gen2/Blob.
# Set to "false" (default) to use local ./data/<env>/{raw,curated} folders.
AZURE_MODE=false

# --- Azure Storage Account (ADLS Gen2 / Blob) ---
# Fill these when AZURE_MODE=true
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_ADLS_FILESYSTEM_RAW=raw-dev
AZURE_ADLS_FILESYSTEM_CURATED=curated-dev

# --- Azure AD Service Principal (for Key Vault / Workload Identity, optional) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure Key Vault (Secrets Management topic) ---
AZURE_KEYVAULT_URI=

# --- Synthetic data volume knobs (Autoscaler Internals demo) ---
SYNTHETIC_ROW_COUNT=250000
SYNTHETIC_BATCH_COUNT=5
RANDOM_SEED=42

# --- Spark runtime ---
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
LOCAL_DATA_ROOT=./data
